# Contraseña del panel de administración (/admin). Obligatoria.
ADMIN_PASSWORD=cambiar-esta-clave

# Clave para firmar la cookie de sesión. Si se omite se usa ADMIN_PASSWORD,
# pero conviene definir una propia para que cambiar la contraseña no sea lo
# único que invalide las sesiones abiertas.
ADMIN_SESSION_SECRET=cadena-larga-y-aleatoria
